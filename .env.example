# =============================================================================
# TruthLens configuration env file template
# Rename to .env and configure keys.
# =============================================================================

# Flask Port (defaults to 5000)
PORT=5000
FLASK_ENV=development

# Optional: Google Custom Search API configuration
# If set, Google Search will be prioritized over DuckDuckGo search.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
